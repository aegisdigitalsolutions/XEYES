# Build output
build/
.gradle/
*.apk
*.aab

# Machine-specific toolchain paths. Every developer's SDK lives somewhere else.
local.properties

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
.coverage
htmlcov/

# Working data. Real observations and derived estimates never belong in version control.
/data/
/out/
*.zip

# The cross-language fixtures are the exception, and have to be: they are how the Kotlin apps and
# the Python Lab agree on a file format without ever sharing a process. Synthetic throughout — a
# fabricated site, fabricated devices, fabricated radio — so nothing real is committed here.
!/contract/*.zip

# Kotlin compiler daemon session files
.kotlin/

# Editors
.idea/
*.iml
.DS_Store

# Swift Package Manager. Unanchored: the package lives at ios/Packages/RFMapper, and its build
# directory should stay ignored wherever it is built from.
.build/
.swiftpm/

# Xcode. The .xcodeproj itself is committed -- it is generated from ios/project.yml, but committing
# it means the project opens without anyone installing XcodeGen first. Per-user state inside it is
# not, because it records window positions and the last scheme a particular developer selected.
DerivedData/
*.xcuserdatad/
xcuserdata/
*.xcworkspace/xcuserdata/

# The signing override. Config/Signing.xcconfig is committed with placeholder values and optionally
# includes this file; a team identifier and a bundle identifier belong to whoever ships the build,
# not to the repository.
ios/Config/Signing.local.xcconfig
