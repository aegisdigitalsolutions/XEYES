# Build output
build/
.gradle/
*.apk
*.aab

# Machine-specific toolchain paths. Every developer's SDK lives somewhere else.
local.properties

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
.coverage
htmlcov/

# Working data. Real observations and derived estimates never belong in version control.
/data/
/out/
*.zip

# The cross-language fixtures are the exception, and have to be: they are how the Kotlin apps and
# the Python Lab agree on a file format without ever sharing a process. Synthetic throughout — a
# fabricated site, fabricated devices, fabricated radio — so nothing real is committed here.
!/contract/*.zip

# Kotlin compiler daemon session files
.kotlin/

# Editors
.idea/
*.iml
.DS_Store
