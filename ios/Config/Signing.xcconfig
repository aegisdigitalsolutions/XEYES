// Signing identity and bundle identifier.
//
// Split out of project.yml because these are the only build settings whose correct value differs
// per person. A DEVELOPMENT_TEAM committed here builds for exactly one developer and fails for
// everybody else, and a bundle identifier is not transferable at all: whoever ships this has to own
// the App ID, so `com.rfmapper.collector` is a placeholder rather than a default.
//
// To sign a build, do not edit this file. Create `Signing.local.xcconfig` beside it -- it is
// gitignored -- and put your values there:
//
//     DEVELOPMENT_TEAM = A1B2C3D4E5
//     PRODUCT_BUNDLE_IDENTIFIER = com.yourcompany.rfmapper
//
// Your team identifier is the ten-character string in the top right of the Apple Developer portal,
// or under Membership details. The bundle identifier must match an App ID that has the
// `Access WiFi Information` capability enabled -- see docs/21-ios-shipping-checklist.md, because a
// provisioning profile without it will not install the build.

PRODUCT_BUNDLE_IDENTIFIER = com.rfmapper.collector

// Empty on purpose. Xcode will build and run on the simulator without a team, and will tell you it
// needs one the moment you target a device or archive.
DEVELOPMENT_TEAM =

// Automatic is right for development and for App Store distribution from Xcode. Set Manual in your
// local override if you sign in CI with a specific profile.
CODE_SIGN_STYLE = Automatic

// Optional, untracked, and last so it wins.
#include? "Signing.local.xcconfig"
