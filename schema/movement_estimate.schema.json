{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rfmapper.local/schema/1.0.0/movement_estimate.schema.json",
  "title": "RFMapper Movement Estimate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "movement_id",
    "algorithm_version",
    "engine_versions",
    "device_id",
    "timestamp_utc",
    "state",
    "confidence",
    "supporting_estimate_ids"
  ],
  "properties": {
    "movement_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "algorithm_version": { "type": "string" },
    "engine_versions": { "type": "object", "additionalProperties": { "type": "string" } },
    "device_id": { "type": "string" },
    "timestamp_utc": { "type": "string" },
    "state": {
      "type": "string",
      "enum": ["STATIONARY", "MOVING", "ZONE_TRANSITION", "LOST", "REAPPEARED", "UNCERTAIN"]
    },
    "origin_zone_id": { "type": ["string", "null"] },
    "candidate_destination_zone_id": { "type": ["string", "null"] },
    "confirmed_destination_zone_id": { "type": ["string", "null"] },
    "direction": {
      "description": "Movement between named spatial regions, e.g. 'B7->B9'. A geometric heading may only be used when actual coordinate evidence supports a vector.",
      "type": ["string", "null"]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "supporting_estimate_ids": { "type": "array", "items": { "type": "string" } },
    "quality_flags": { "type": "array", "items": { "type": "string" } }
  },
  "allOf": [
    {
      "$comment": "A ZONE_TRANSITION state must name where it is coming from and where it may be going.",
      "if": { "properties": { "state": { "const": "ZONE_TRANSITION" } }, "required": ["state"] },
      "then": {
        "required": ["origin_zone_id", "candidate_destination_zone_id"],
        "properties": {
          "origin_zone_id": { "type": "string" },
          "candidate_destination_zone_id": { "type": "string" }
        }
      }
    },
    {
      "$comment": "A LOST device has no supporting estimates by definition, but every other state must be evidenced.",
      "if": {
        "properties": { "state": { "enum": ["STATIONARY", "MOVING", "ZONE_TRANSITION", "REAPPEARED"] } },
        "required": ["state"]
      },
      "then": { "properties": { "supporting_estimate_ids": { "minItems": 1 } } }
    }
  ]
}
